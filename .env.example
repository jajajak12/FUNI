# Safe defaults. Do not set EXECUTION_ENABLED=true until official Uniswap v3 deployments
# have been independently verified and an operator completes execution-preflight.
# All values are placeholders only. No real secrets, addresses, or credentials belong here.
NODE_ENV=production
RH_CHAIN_ID=
RH_RPC_URL=
RH_RPC_FALLBACK_URL=
ALCHEMY_RPC_URL=
ALCHEMY_RPC_URLS=
RH_LOGS_RPC_URL=
EXECUTION_ENABLED=false
DRY_RUN=true
EMERGENCY_PAUSE=true
LIVE_CANARY_ENABLED=false
# Telegram bot token from @BotFather. Leave empty until allowlisted users are set.
ROBIN_TELEGRAM_BOT_TOKEN=
# Single user/chat id allowed to interact with the bot. Comma-separated list allowed.
ROBIN_TELEGRAM_CHAT_ID=
# Optional destination for GMGN alert worker. Leave empty to disable Telegram delivery.
GMGN_ALERT_TELEGRAM_CHAT_ID=
GMGN_ALERT_GROUP_CHAT_ID=
GMGN_ALERT_ENABLED=false
GMGN_ALERT_TELEGRAM_DELIVERY_ENABLED=false
GMGN_ALERT_INTERVAL_MS=100000
TELEGRAM_ALLOWED_USER_IDS=
# EOA private key used for read-only simulations and dry-runs. Leave empty in shared envs.
LP_PRIVATE_KEY=
# Public address used only for balances, allowance reads, and authorized eth_call simulations.
OPERATOR_WALLET=
DEDICATED_WALLET_ADDRESS=
WALLET_ADDRESS=
WALLET_POSITION_FROM_BLOCK=
MAX_POSITION_VALUE_USD=1000
MAX_REBALANCE_COMPOUND_VALUE_USD=5000
MAX_REBALANCE_APPROVAL_VALUE_USD=5000
MAX_APPROVAL_VALUE_USD=1000
MAX_BOT_MANAGED_EXPOSURE_USD=
MAX_GAS_COST_USD=0.25
MAX_LIFECYCLE_GAS_USD=1
V4_LIVE_CANARY_ENABLED=false
V4_CANARY_MAX_TX_GAS_USD=0.25
V4_CANARY_TOTAL_GAS_BUDGET_USD=1
LIVE_CANARY_MAX_OPEN_POSITIONS=1
DIRECT_LOOKUP_DEADLINE_MS=10000
DIRECT_LOOKUP_RESULT_TTL_MS=300000
DIRECT_LOOKUP_CANDIDATE_BUDGET=12
DIRECT_LOOKUP_MAX_RPC_BATCHES=1
DIRECT_LOOKUP_ETH_CALL_BUDGET=24
DIRECT_LOOKUP_WORKER_IDLE_MS=750
DIRECT_LOOKUP_OUTBOX_CADENCE_MS=750
DIRECT_LOOKUP_OUTBOX_RETRY_COUNT=3
STATE_CACHE_CADENCE_MS=60000
STATE_CACHE_ACTIVE_POOL_TTL_MS=120000
STATE_CACHE_BATCH_LIMIT=16
ACTIVE_POSITION_RECONCILIATION_CADENCE_MS=300000
ACTIVE_POSITION_RECONCILIATION_TTL_MS=300000
ACTIVE_POSITION_RECONCILIATION_LIMIT=16
MAX_SLIPPAGE_BPS=50
AUTO_APPROVE_BEFORE_MINT=true
AUTO_OPEN_AFTER_AMOUNT=true
# Required only when live canary execution is intentionally enabled; fail closed otherwise.
GAS_USD_PER_NATIVE=
APPROVAL_CAP_MULTIPLIER_BPS=10050
DATA_DIR=./data
# Optional override. Defaults to ${DATA_DIR}/robinhood-lp.sqlite.
DATABASE_PATH=
BACKUP_RETENTION=7
CONFIRMATION_TTL_SECONDS=300
TELEGRAM_SESSION_TTL_SECONDS=600
# Optional canonical Uniswap v3 pool used for native USD pricing. Leave empty to auto-discover.
V4_CANONICAL_NATIVE_USD_POOL=
V4_PREVIEW_STATIC_VERIFICATION_TTL_MS=900000
V4_PREVIEW_NATIVE_USD_TTL_MS=60000
LOG_LEVEL=info
V4_REGISTRY_CADENCE_MS=15000
