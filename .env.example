# FUNI public configuration — placeholders only. Never commit `.env`.
NODE_ENV=production

# Robinhood Chain RPC (chain ID 4663)
RH_CHAIN_ID=4663
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
RH_RPC_FALLBACK_URL=
RH_LOGS_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ALCHEMY_RPC_URL=
ALCHEMY_RPC_URLS=

# Local runtime data
DATA_DIR=./data
DATABASE_PATH=./data/funi.sqlite
BACKUP_RETENTION=7

# Public wallet address used for ownership, balance, and allowance reads.
# When more than one alias is set, every value must resolve to the same address.
WALLET_ADDRESS=
OPERATOR_WALLET=
DEDICATED_WALLET_ADDRESS=
WALLET_POSITION_FROM_BLOCK=

# Telegram. Use only credentials and IDs you control.
FUNI_TELEGRAM_BOT_TOKEN=
FUNI_TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_SESSION_TTL_SECONDS=600
CONFIRMATION_TTL_SECONDS=300

# Fail-closed defaults. Installation does not authorize a transaction.
EXECUTION_ENABLED=false
DRY_RUN=true
EMERGENCY_PAUSE=true
LIVE_CANARY_ENABLED=false
V4_LIVE_CANARY_ENABLED=false
LP_PRIVATE_KEY=

# User-defined risk limits
MAX_POSITION_VALUE_USD=1000
MAX_APPROVAL_VALUE_USD=1000
MAX_GAS_COST_USD=0.25
MAX_LIFECYCLE_GAS_USD=1
MAX_SLIPPAGE_BPS=50
APPROVAL_CAP_MULTIPLIER_BPS=10050
GAS_USD_PER_NATIVE=
V4_CANARY_MAX_TX_GAS_USD=0.25
V4_CANARY_TOTAL_GAS_BUDGET_USD=1
LIVE_CANARY_MAX_OPEN_POSITIONS=1

# Manual OPEN preflight
V4_CANONICAL_NATIVE_USD_POOL=
V4_PREVIEW_STATIC_VERIFICATION_TTL_MS=900000
V4_PREVIEW_NATIVE_USD_TTL_MS=60000

# V3/V4 discovery and state freshness
V4_REGISTRY_CADENCE_MS=15000
DIRECT_LOOKUP_DEADLINE_MS=10000
DIRECT_LOOKUP_RESULT_TTL_MS=300000
DIRECT_LOOKUP_CANDIDATE_BUDGET=12
DIRECT_LOOKUP_MAX_RPC_BATCHES=1
DIRECT_LOOKUP_ETH_CALL_BUDGET=24
DIRECT_LOOKUP_WORKER_IDLE_MS=750
DIRECT_LOOKUP_OUTBOX_CADENCE_MS=750
DIRECT_LOOKUP_OUTBOX_RETRY_COUNT=3
STATE_CACHE_CADENCE_MS=60000
STATE_CACHE_ACTIVE_POOL_TTL_MS=120000
STATE_CACHE_BATCH_LIMIT=16
ACTIVE_POSITION_RECONCILIATION_CADENCE_MS=60000
ACTIVE_POSITION_RECONCILIATION_TTL_MS=300000
ACTIVE_POSITION_RECONCILIATION_LIMIT=16
MULTICHAIN_READ_ONLY_CADENCE_MS=60000

# Optional read-only BSC / Ethereum inspection. Execution remains disabled.
BSC_ENABLED=false
BSC_EXECUTION_ENABLED=false
BSC_DRY_RUN=true
BSC_EMERGENCY_PAUSE=true
BSC_RPC_URLS=
BSC_RPC_URL=
BSC_CONFIRMATIONS=
BSC_WALLET_ADDRESS=
ETHEREUM_ENABLED=false
ETHEREUM_EXECUTION_ENABLED=false
ETHEREUM_DRY_RUN=true
ETHEREUM_EMERGENCY_PAUSE=true
ETHEREUM_RPC_URLS=
ETHEREUM_RPC_URL=
ETHEREUM_CONFIRMATIONS=
ETHEREUM_WALLET_ADDRESS=

# Optional token-price reference used by final manual OPEN preflight.
# Supply through protected process configuration, never source control.
GMGN_API_KEY=
FUNI_GMGN_CREDENTIAL_PRELOAD_PATH=

LOG_LEVEL=info
